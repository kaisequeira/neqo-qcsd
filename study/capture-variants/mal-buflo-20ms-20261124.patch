+fn b817_observe_live_tail_with_header(
+    controller: &mut QcsdController,
+    data_bytes: u64,
+    frame_header_bytes: u64,
+    final_lease_read: u64,
+    sequence: u64,
+) {
+    let endpoint = QcsdEndpointId(1);
+    let stream = QcsdStreamId(80);
+    for (offset, bytes) in [(0, 1), (1, 1), (2, 3)] {
+        b817_observe(
+            controller,
