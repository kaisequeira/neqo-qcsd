+        let record = slotful.terminal_chaff_postlease_live_data().unwrap();
+        assert!(record.owned_advertised_at_us.is_none());
+        assert!(record.owned_advertised_at_ns.is_none());
+        assert!(!record.owned_advertised_predeadline_verified);
