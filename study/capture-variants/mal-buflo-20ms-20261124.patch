+    assert_eq!(owner.slot, QcsdSlotId(0));
+    assert_eq!(
+        actions
+            .iter()
+            .filter(|action| matches!(
+                action,
+                QcsdAction::LeaseParserReceive {
+                    endpoint: candidate_endpoint,
+                    stream: candidate_stream,
+                    increase: 600,
+                    owner: Some(_),
+                    ..
+                } if *candidate_endpoint == endpoint && *candidate_stream == stream
