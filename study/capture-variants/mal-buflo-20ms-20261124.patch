+        },
+        "field_names": [
+            "queued_after_expiry", "front_present_before_expiry", "front_slot",
+            "front_committed", "front_not_before_is_future", "front_deadline_expired",
+            "eligible_present", "eligible_slot", "eligible_desired_udp_bytes",
