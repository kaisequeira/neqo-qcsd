+            endpoint, stream, absolute_limit: 1_016, slot: None,
+        },
+        3,
+        sequence,
+    );
+    b817_observe(
+        controller,
+        QcsdObservation::StreamDataBlocked { endpoint, stream, blocked_at: 1_016 },
+        4,
+        sequence + 1,
+    );
+    b817_observe_live_tail_with_header(
+        controller,
+        data_bytes,
+        frame_header_bytes,
+        final_lease_read,
