+            record.request_id,
+            record.endpoint,
+            record.stream,
+            record.slot,
+            record.lease_start,
+            record.lease_end,
+        ),
+        (4, 0, 1, 80, 0, 1_000, 1_016)
+    );
+    assert_eq!(
+        (
+            record.frame_header_start,
+            record.frame_payload_start,
+            record.frame_payload_end,
+            record.lease_consumption_end,
+            record.owned_lease_start,
+            record.owned_lease_end,
+            record.handoff_at_us,
